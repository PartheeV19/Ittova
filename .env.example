API_PORT=3001
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000

POSTGRES_DB=ittova
POSTGRES_USER=ittova
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ittova:replace-with-a-local-password@localhost:5432/ittova
DB_POOL_MAX=10

# OTP delivery: server only. Never prefix secrets with VITE_.
RESEND_API_KEY=
# A sender at a domain you have verified in Resend, e.g. ITOVA <otp@your-domain.com>
OTP_EMAIL_FROM=
# Generate at least 32 random bytes; setup instructions are in server/OTP_SETUP.md.
OTP_HASH_SECRET=
# SMS: MSG91 SMS template with one variable containing the same OTP as the email.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VARIABLE=OTP
